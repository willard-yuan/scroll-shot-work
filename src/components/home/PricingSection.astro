---
import SectionHeading from './SectionHeading.astro';

interface Plan {
	name: string;
	price: string;
	subtitle: string;
	features: string[];
	featured?: boolean;
	badge?: string;
	button?: {
		label: string;
		href: string;
		style?: 'light' | 'dark';
	};
}

interface Props {
	heading: {
		kicker: string;
		title: string;
		description: string;
	};
	plans: Plan[];
	appStoreUrl: string;
	buttonLabel: string;
	note?: string;
}

const { heading, plans, appStoreUrl, buttonLabel, note } = Astro.props;
---

<section class="section section-band pricing-section" id="pricing">
	<SectionHeading
		kicker={heading.kicker}
		title={heading.title}
		description={heading.description}
		tone="gold"
	/>
	<div class="pricing-grid">
		{plans.map((plan) => (
			<article class:list={['price-card', plan.featured && 'featured']}>
				<div class="price-card-header">
					<div class="price-card-device">
						<svg class="price-card-apple" viewBox="0 0 814 1000" aria-hidden="true">
							<path
								fill="currentColor"
								d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 793.2 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.9 43.4 39.5 0 101.1-45.9 175.5-45.9 28.5 0 130.9 2.5 198.7 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.2-50.6 1.9-110.8 33.7-146.8 75.8-28.9 33.4-56.5 86.2-56.5 139.9 0 8.2 1.4 16.4 1.9 19.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.6-76.6z"
							/>
						</svg>
						<span class="price-card-device-name">{plan.name}</span>
						{plan.badge && <span class="price-card-badge">{plan.badge}</span>}
					</div>
					<h3 class:list={['price-card-price', plan.price === 'Free' && 'price-free']}>{plan.price}</h3>
					<p class="price-card-subtitle">{plan.subtitle}</p>
				</div>
				<ul class="price-card-features">
					{plan.features.map((feature) => <li>{feature}</li>)}
				</ul>
				{
					plan.button ? (
						<a
							class:list={['price-card-button', plan.button.style === 'dark' ? 'price-card-button-dark' : 'price-card-button-light']}
							href={plan.button.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<svg class="price-card-button-apple" viewBox="0 0 814 1000" aria-hidden="true">
								<path
									fill="currentColor"
									d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 793.2 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.9 43.4 39.5 0 101.1-45.9 175.5-45.9 28.5 0 130.9 2.5 198.7 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.2-50.6 1.9-110.8 33.7-146.8 75.8-28.9 33.4-56.5 86.2-56.5 139.9 0 8.2 1.4 16.4 1.9 19.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.6-76.6z"
								/>
							</svg>
							{plan.button.label}
						</a>
					) : plan.featured ? (
						<a class="button button-mint" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
							{buttonLabel}
						</a>
					) : null
				}
			</article>
		))}
	</div>
	{note && <p class="pricing-note">{note}</p>}
</section>

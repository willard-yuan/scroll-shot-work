---
interface Props {
	appStoreUrl: string;
	video: string;
	videoCover: string;
	content: {
		eyebrow: string;
		title: string;
		subtitle: string;
		text: string;
		primaryCta: string;
		secondaryCta: string;
		secondaryCtaHref?: string;
		secondaryCtaApple?: boolean;
		videoAria: string;
		videoLabel: string;
		caption: string;
		trustSignals?: Array<{
			value?: string;
			label: string;
			note?: string;
			tone?: 'rating' | 'privacy' | 'export';
		}>;
	};
}

const { appStoreUrl, video, videoCover, content } = Astro.props;
const secondaryHref = content.secondaryCtaHref || video;
const secondaryIsDark = Boolean(content.secondaryCtaApple);
---

<section class="hero" id="top">
	<div class="hero-copy">
		<p class="eyebrow">{content.eyebrow}</p>
		<h1>{content.title}</h1>
		<h2>{content.subtitle}</h2>
		<p class="hero-text">{content.text}</p>
		<div class="hero-actions">
			<a class="button button-light button-lg" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
				<span class="apple-mark" aria-hidden="true">
				<svg viewBox="0 0 384 512" aria-hidden="true">
					<path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
				</svg>
			</span>
				{content.primaryCta}
			</a>
			<a class={`button button-lg ${secondaryIsDark ? 'button-dark' : 'button-ghost'}`} href={secondaryHref} target="_blank" rel="noopener noreferrer">
				{content.secondaryCtaApple && (
					<span class="apple-mark" aria-hidden="true">
						<svg viewBox="0 0 384 512" aria-hidden="true">
							<path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
						</svg>
					</span>
				)}
				{content.secondaryCta}
			</a>
		</div>
		{
			content.trustSignals && (
				<div class="hero-trust-list" aria-label="ScrollShot 信任信号">
					{content.trustSignals.map((item) => (
						<div class:list={['hero-trust-item', item.tone && `trust-${item.tone}`]}>
							{item.value && <strong>{item.value}</strong>}
							<span>{item.label}</span>
							{item.note && <small>{item.note}</small>}
						</div>
					))}
				</div>
			)
		}
	</div>

	<a class="hero-device-link" href={video} aria-label={content.videoAria} target="_blank" rel="noopener noreferrer">
		<div class="device-shell">
			<div class="device-screen video-screen">
				<video
					src={video}
					poster={videoCover}
					width="886"
					height="1920"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					aria-label={content.videoLabel}
				></video>
			</div>
		</div>
		<span class="device-caption">{content.caption}</span>
	</a>
</section>
